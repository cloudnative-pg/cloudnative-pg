apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cluster-declarative-backup-cold-restore
spec:
  instances: 2
  primaryUpdateStrategy: unsupervised

  # Persistent storage configuration
  storage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
  walStorage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi

  # A cold backup includes the WAL volume: no WAL archive is needed to recover.
  bootstrap:
    recovery:
      volumeSnapshots:
        storage:
          name: ${SNAPSHOT_NAME_PGDATA}
          kind: VolumeSnapshot
          apiGroup: snapshot.storage.k8s.io
        walStorage:
          name: ${SNAPSHOT_NAME_PGWAL}
          kind: VolumeSnapshot
          apiGroup: snapshot.storage.k8s.io
