apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cluster-declarative-backup-restore
spec:
  instances: 2
  primaryUpdateStrategy: unsupervised

  # Persistent storage configuration
  storage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
  walStorage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi

  bootstrap:
    recovery:
      # The online backup has no WAL storage snapshot: the WAL files are fetched
      # from the archive of the source cluster.
      source: cluster-declarative-backup
      volumeSnapshots:
        storage:
          name: ${SNAPSHOT_NAME_PGDATA}
          kind: VolumeSnapshot
          apiGroup: snapshot.storage.k8s.io

  externalClusters:
    - name: cluster-declarative-backup
      barmanObjectStore:
        destinationPath: s3://cluster-declarative-backup/
        endpointURL: https://object-store.object-store:9000
        endpointCA:
          key: ca.crt
          name: object-store-ca-secret
        s3Credentials:
          accessKeyId:
            name: backup-storage-creds
            key: ID
          secretAccessKey:
            name: backup-storage-creds
            key: KEY
