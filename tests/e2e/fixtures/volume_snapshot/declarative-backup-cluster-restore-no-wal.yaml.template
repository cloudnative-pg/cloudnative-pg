apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cluster-declarative-backup-restore-no-wal
spec:
  instances: 1
  primaryUpdateStrategy: unsupervised

  # Persistent storage configuration: unlike the cluster that has been backed
  # up, there is no separate volume for the WAL files
  storage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi

  bootstrap:
    recovery:
      # The online backup has no WAL storage snapshot: the WAL files are fetched
      # through plugin-barman-cloud from the archive of the source cluster.
      source: cluster-declarative-backup
      volumeSnapshots:
        storage:
          name: ${SNAPSHOT_NAME_PGDATA}
          kind: VolumeSnapshot
          apiGroup: snapshot.storage.k8s.io

  externalClusters:
    - name: cluster-declarative-backup
      plugin:
        name: barman-cloud.cloudnative-pg.io
        parameters:
          barmanObjectName: cluster-declarative-backup
          serverName: cluster-declarative-backup
