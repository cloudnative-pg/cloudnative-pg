apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cluster-oom-primary-replica
spec:
  instances: 3

  postgresql:
    synchronous:
      method: any
      number: 1
      dataDurability: required
      failoverQuorum: true
    parameters:
      shared_buffers: 100MB

  resources:
    limits:
      memory: 120Mi
    requests:
      memory: 120Mi

  storage:
    storageClass: ${E2E_DEFAULT_STORAGE_CLASS}
    size: 1Gi
