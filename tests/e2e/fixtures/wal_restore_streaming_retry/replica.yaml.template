apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: streaming-retry-replica
spec:
  instances: 1

  bootstrap:
    pg_basebackup:
      source: streaming-retry-source

  replica:
    enabled: true
    source: streaming-retry-source
    # The designated primary replays the WAL 20 seconds after the source wrote
    # it, so the archive always has the next WAL file it needs. With a WAL file
    # written every second, the source keeps the WAL it streams from: one
    # minute would exceed the 32 WAL files of the default wal_keep_size
    minApplyDelay: 20s

  # Like on the source, pg_wal grows to about 1.1GB
  storage:
    size: 2Gi
    storageClass: ${E2E_DEFAULT_STORAGE_CLASS}

  externalClusters:
    - name: streaming-retry-source
      connectionParameters:
        host: streaming-retry-source-rw
        user: streaming_retry
        dbname: app
        port: "5432"
      password:
        name: streaming-retry-source-app
        key: password
      plugin:
        name: barman-cloud.cloudnative-pg.io
        parameters:
          barmanObjectName: streaming-retry-source
          serverName: streaming-retry-source
