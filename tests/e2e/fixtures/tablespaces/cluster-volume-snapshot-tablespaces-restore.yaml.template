apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cluster-tablespaces-volume-snapshot-restore
spec:
  instances: 2
  primaryUpdateStrategy: unsupervised

  # Persistent storage configuration
  storage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
  walStorage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
  tablespaces:
    - name: tbs1
      storage:
        storageClass: ${E2E_CSI_STORAGE_CLASS}
        size: 1Gi
    - name: tbs2
      storage:
        storageClass: ${E2E_CSI_STORAGE_CLASS}
        size: 1Gi

  bootstrap:
    recovery:
      # The online backup has no WAL storage snapshot: the WAL files are
      # fetched from the archive of the source cluster.
      source: cluster-tablespaces-volume-snapshot
      backup:
        name: ${BACKUP_NAME}
        # With the in-tree barmanObjectStore, when recovering from a volume
        # snapshot Backup whose WALs come from a source with an endpointCA, the
        # operator looks for the CA in the Backup status only, and volume
        # snapshot Backups don't set status.endpointCA. The CA of the source is
        # never consulted, so the CA file that AWS_CA_BUNDLE points to is not
        # written. Set it here too so it's injected.
        endpointCA:
          name: object-store-ca-secret
          key: ca.crt

  externalClusters:
  - name: cluster-tablespaces-volume-snapshot
    barmanObjectStore:
      destinationPath: s3://cluster-tablespaces-volume-snapshot/
      endpointURL: https://object-store.object-store:9000
      endpointCA:
        key: ca.crt
        name: object-store-ca-secret
      s3Credentials:
        accessKeyId:
          name: backup-storage-creds
          key: ID
        secretAccessKey:
          name: backup-storage-creds
          key: KEY
