apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cluster-tablespaces-volume-snapshot-restore
spec:
  instances: 2
  primaryUpdateStrategy: unsupervised

  # Persistent storage configuration
  storage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
  walStorage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
  tablespaces:
    - name: tbs1
      storage:
        storageClass: ${E2E_CSI_STORAGE_CLASS}
        size: 1Gi
    - name: tbs2
      storage:
        storageClass: ${E2E_CSI_STORAGE_CLASS}
        size: 1Gi

  bootstrap:
    recovery:
      # The online backup has no WAL storage snapshot: the WAL files are
      # fetched from the archive of the source cluster.
      source: cluster-tablespaces-volume-snapshot
      backup:
        name: ${BACKUP_NAME}

  # Fetch the WAL files through plugin-barman-cloud. The ObjectStore is created
  # by the test and points at the bucket the source cluster archived to.
  externalClusters:
  - name: cluster-tablespaces-volume-snapshot
    plugin:
      name: barman-cloud.cloudnative-pg.io
      parameters:
        barmanObjectName: cluster-tablespaces-volume-snapshot
        serverName: cluster-tablespaces-volume-snapshot
