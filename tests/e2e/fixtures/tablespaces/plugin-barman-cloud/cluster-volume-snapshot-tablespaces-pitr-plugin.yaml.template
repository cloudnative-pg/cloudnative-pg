apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: cluster-tablespaces-volume-snapshot-plugin-pitr
spec:
  instances: 2
  primaryUpdateStrategy: unsupervised

  storage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi
  walStorage:
    storageClass: ${E2E_CSI_STORAGE_CLASS}
    size: 1Gi

  tablespaces:
    - name: tbs1
      storage:
        storageClass: ${E2E_CSI_STORAGE_CLASS}
        size: 1Gi
    - name: tbs2
      storage:
        storageClass: ${E2E_CSI_STORAGE_CLASS}
        size: 1Gi

  bootstrap:
    recovery:
      source: cluster-tablespaces-volume-snapshot-plugin
      volumeSnapshots:
        storage:
          name: ${SNAPSHOT_PLUGIN_TBS_PITR_PGDATA}
          kind: VolumeSnapshot
          apiGroup: snapshot.storage.k8s.io
        tablespaceStorage:
          tbs1:
            name: ${SNAPSHOT_PLUGIN_TBS_PITR_PGTABLESPACE_tbs1}
            kind: VolumeSnapshot
            apiGroup: snapshot.storage.k8s.io
          tbs2:
            name: ${SNAPSHOT_PLUGIN_TBS_PITR_PGTABLESPACE_tbs2}
            kind: VolumeSnapshot
            apiGroup: snapshot.storage.k8s.io
      recoveryTarget:
        targetTime: ${SNAPSHOT_PLUGIN_TBS_PITR}

  # WALs are fetched through plugin-barman-cloud from the ObjectStore the
  # source cluster archived to (created by the test).
  externalClusters:
  - name: cluster-tablespaces-volume-snapshot-plugin
    plugin:
      name: barman-cloud.cloudnative-pg.io
      parameters:
        barmanObjectName: cluster-tablespaces-volume-snapshot-plugin
        serverName: cluster-tablespaces-volume-snapshot-plugin
